    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@slack/bolt": "^4.5.0",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.20.5",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.2"
}
